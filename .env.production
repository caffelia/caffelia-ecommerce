# Application Configuration
APP_NAME=Cafelia
APP_ENV=production
APP_KEY=base64:1Rm9uQMm/0cdFiWpT3IdDtPBKkwZOnCq+sRjxpTKo3k=
APP_DEBUG=false
APP_DEBUG_ALLOWED_IPS=
APP_URL=https://cafelia.laravel-cloud.com
APP_ADMIN_URL=admin

# Colombian Configuration
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO
APP_CURRENCY=COP

# Application Settings
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Docker PostgreSQL)
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="cafelia_ecommerce"
DB_USERNAME="bagisto"
DB_PASSWORD="secret123"

# Session Configuration (Using Redis for performance)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting
BROADCAST_CONNECTION=log

# File Storage
FILESYSTEM_DISK=public

# Queue Configuration (Using Redis)
QUEUE_CONNECTION=redis

# Cache Configuration (Using Docker Redis)
CACHE_STORE=redis
CACHE_PREFIX=cafelia_

# Memory Cache
MEMCACHED_HOST=127.0.0.1

# Redis Configuration (Docker Redis)
REDIS_CLIENT=phpredis
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

# Response Cache
RESPONSE_CACHE_ENABLED=true

# Mail Configuration (Docker Mailpit for local testing)
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@cafelia.com
MAIL_FROM_NAME="Cafelia E-commerce"

# Admin Mail
ADMIN_MAIL_ADDRESS=admin@cafelia.com
ADMIN_MAIL_NAME="Cafelia Admin"

# AWS Configuration (for future cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Configuration
VITE_APP_NAME=Cafelia
VITE_HOST=localhost
VITE_PORT=5173

# Mercado Pago Configuration (Colombian Payment Gateway)
MERCADOPAGO_PUBLIC_KEY=TEST-your-public-key-here
MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token-here
MERCADOPAGO_TEST_MODE=true
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret-here
MERCADOPAGO_INTEGRATOR_ID=dev_24c65fb163bf11ea96500242ac130004

# Colombian Business Configuration
BUSINESS_TIMEZONE=America/Bogota
DEFAULT_CURRENCY=COP
DEFAULT_LOCALE=es_CO
BUSINESS_COUNTRY=CO
TAX_RATE=19.00

# Search Configuration (if using Elasticsearch later)
SCOUT_DRIVER=null
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Performance Optimization
CACHE_DRIVER=redis
SESSION_CACHE_STORE=redis
QUEUE_CACHE_STORE=redis

# Development Tools
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# Colombian Shipping Zones (for future use)
SHIPPING_ZONES=BOG,MED,CAL,BAQ,CTG,BUC
DEFAULT_SHIPPING_ZONE=BOG

# Colombian Tax Configuration
IVA_RATE=19
ICA_RATE=0.966
RETEFUENTE_RATE=3.5

# Security
SANCTUM_STATEFUL_DOMAINS=localhost:8000
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
